# ─── Banco de dados ────────────────────────────────────────────────
# Desenvolvimento local sem Docker: `npm run db:local` sobe um PostgreSQL
# embutido (binários oficiais via npm) na porta 5433 com estes dados.
DATABASE_URL="postgresql://doislados:doislados@localhost:5433/doislados?schema=public"
# Conexão direta para migrações. Localmente, igual à DATABASE_URL.
# No Supabase: DATABASE_URL = pooler "Transaction" (porta 6543, com ?pgbouncer=true&connection_limit=1)
#              DIRECT_URL   = pooler "Session" (porta 5432)
DIRECT_URL="postgresql://doislados:doislados@localhost:5433/doislados?schema=public"

# ─── Aplicação ─────────────────────────────────────────────────────
# URL pública canônica (usada em metadados, sitemap e checagem de origem).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# E-mail público de contato (apoio, imprensa, parcerias). Use um endereço do domínio
# que encaminha para o seu e-mail pessoal — não publique o pessoal.
CONTACT_EMAIL=""
# Envio do formulário de anúncio (resend.com). Sem estes dois, as mensagens
# ficam guardadas no painel (/admin → Relatos) em vez de irem por e-mail.
RESEND_API_KEY=""
MAIL_FROM="DOIS LADOS <site@qualmeulado.com.br>"

# ─── Administração ─────────────────────────────────────────────────
# Conta criada pelo seed. Em produção, use `npm run admin:create` e
# uma senha forte (mín. 12 caracteres). Nunca versione o arquivo .env.
SEED_ADMIN_EMAIL="admin@doislados.local"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administração"

# Exige que a verificação editorial seja feita por pessoa diferente
# de quem fez a última edição (princípio dos quatro olhos).
EDITORIAL_REQUIRE_SECOND_REVIEWER="true"

# ─── Funcionalidades condicionais ──────────────────────────────────
# Resultados coletivos ficam DESLIGADOS por padrão. Ativar exige, além
# desta variável, registro de parecer jurídico no painel (FeatureFlag).
COLLECTIVE_RESULTS_ENABLED="false"
# Medição agregada (anônima, desligada). Só ative após parecer jurídico; ver docs/SEGURANCA-E-LGPD.md
AGGREGATE_METRICS_ENABLED="false"
